NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://governbright:governbright@localhost:5432/governbright
# Dev auth trusts x-dev-* headers and lets any caller impersonate any user.
# Enable it only for local development; the app refuses to start with it in production.
ALLOW_DEV_AUTH=false
APP_ORIGIN=http://localhost:3000
SESSION_TTL_HOURS=12
# Encrypts stored secrets (MFA seeds, SSO client secrets, Slack webhooks, SCIM tokens).
# Generate with: openssl rand -base64 32. Required in production.
APP_ENCRYPTION_KEY=
# Outgoing mail for password resets. Without it, mail is printed to the log in development.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=GovernBright <no-reply@example.com>
